{
  "name": "vscode-lurk",
  "displayName": "Lurk QQ",
  "version": "0.1.0",
  "description": "Syntax Highlighting For Haskell Lurk QuasiQuotes",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lurk",
    "haskell",
    "quasi-quotation",
    "html",
    "templates"
  ],
  "license": "MIT",
  "publisher": "fernandoromay",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:haskell"
  ],
  "engines": {
    "vscode": "^1.66.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.66.0",
    "typescript": "^4.5.0",
    "esbuild": "^0.14.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Lurk",
      "properties": {
        "lurk.hlsPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the haskell-language-server-wrapper executable. If left empty, it will attempt to find it automatically."
        }
      }
    },
    "grammars": [
      {
        "injectTo": [
          "source.haskell"
        ],
        "scopeName": "source.lurk",
        "path": "./syntaxes/lurk.json",
        "embeddedLanguages": {
          "meta.embedded.block.lurk.1": "html",
          "meta.embedded.block.lurk.2": "html",
          "meta.embedded.block.lurk.3": "html",
          "meta.embedded.block.haskell.1": "haskell",
          "meta.embedded.block.haskell.2": "haskell",
          "meta.embedded.block.haskell.3": "haskell",
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "injectTo": [
          "source.haskell"
        ],
        "scopeName": "inline.lurk.injection",
        "path": "./syntaxes/lurk-injection.json",
        "embeddedLanguages": {
          "meta.embedded.block.haskell.1": "haskell",
          "meta.embedded.block.haskell.2": "haskell",
          "meta.embedded.block.haskell.3": "haskell",
          "source.haskell": "haskell"
        }
      },
      {
        "injectTo": [
          "source.haskell"
        ],
        "scopeName": "source.lurksql",
        "path": "./syntaxes/lurksql.json",
        "embeddedLanguages": {
          "meta.embedded.block.lurksql": "sql",
          "meta.embedded.block.haskell": "haskell"
        }
      },
      {
        "injectTo": [
          "source.haskell"
        ],
        "scopeName": "inline.lurksql.injection",
        "path": "./syntaxes/lurksql-injection.json",
        "embeddedLanguages": {
          "meta.embedded.block.haskell": "haskell",
          "source.haskell": "haskell"
        }
      }
    ],
    "snippets": [
      {
        "language": "haskell",
        "path": "./snippets/lurk.json"
      }
    ]
  },
  "icon": "./extras/lurk-logo.png",
  "galleryBanner": {
    "color": "#1d8fff",
    "theme": "light"
  }
}
